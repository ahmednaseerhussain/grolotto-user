PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://user:password@localhost:5432/grolotto
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_second_long_random_secret

FRONTEND_URL=http://localhost:19006
LANDING_FRONTEND_URL=http://localhost:5173
ADMIN_WEB_URL=http://localhost:5174

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@grolotto.com
# Gmail app password: paste the 16 characters without spaces
SMTP_PASS=replace_with_16_char_app_password
SMTP_FROM=GroLotto <no-reply@grolotto.com>
SMTP_SECURE=false

STRIPE_SECRET_KEY=sk_test_your_secret_key
# Webhook endpoint path: /api/landing/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

RATE_LIMIT_ENABLED=true
